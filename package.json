{
  "name": "wordcraft-embed",
  "version": "1.0.1",
  "description": "Embed the WordCraft word processor (open .docx, edit, save) in any web page",
  "type": "module",
  "main": "src/wordcraft-embed.js",
  "module": "src/wordcraft-embed.js",
  "types": "src/wordcraft-embed.d.ts",
  "exports": {
    ".": {
      "types": "./src/wordcraft-embed.d.ts",
      "default": "./src/wordcraft-embed.js"
    },
    "./relay/server.mjs": "./relay/server.mjs",
    "./relay/token.mjs": "./relay/token.mjs",
    "./relay/webhook.mjs": "./relay/webhook.mjs"
  },
  "files": [
    "src",
    "scripts",
    "relay/*.mjs",
    "relay/comment-commands.json",
    "relay/suggest-commands.json",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "wordcraftVersion": "1.0.1",
  "scripts": {
    "fetch-editor": "node scripts/fetch-editor.mjs",
    "start": "node examples/server.mjs",
    "test": "node --test 'relay/test/*.test.mjs' 'test/*.test.mjs'",
    "test:e2e": "node --test test/e2e/collab.e2e.mjs test/e2e/api.e2e.mjs test/e2e/agent.e2e.mjs test/e2e/roles.e2e.mjs"
  },
  "keywords": [
    "word",
    "docx",
    "editor",
    "word-processor",
    "wordcraft",
    "embed",
    "wasm"
  ],
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
